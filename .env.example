# ============================================================================
#  Mewvia — copy to .env and fill in.  Never commit .env.
# ============================================================================

# ---- Telegram ----
# From @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Bot username WITHOUT the leading @ (needed later for sticker pack names,
# which must end in _by_<bot_username>)
BOT_USERNAME=MewviaBot
# Numeric Telegram IDs of admins, comma-separated. Get yours from @userinfobot.
ADMIN_IDS=123456789

# Leave empty to use the public Bot API (download <=20MB, upload <=50MB).
# Set to http://telegram-bot-api:8081 after enabling the local server in
# docker-compose.yml (raises both limits to ~2GB).
TELEGRAM_API_URL=

# Only needed when the local Bot API server is enabled (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Database ----
POSTGRES_DB=mewvia
POSTGRES_USER=mewvia
POSTGRES_PASSWORD=change-me-please
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Runtime ----
LOG_LEVEL=INFO
LOG_JSON=true
TMP_DIR=/data/tmp
BACKUP_DIR=/data/backups
# age public key. Backups are encrypted with it and sent to the admin chat.
BACKUP_AGE_RECIPIENT=""
# age secret key (AGE-SECRET-KEY-...). Only needed to restore an encrypted
# dump from the admin panel. Keep it on the server if you want self-service
# restores; leave empty to make restores a manual, offline operation.
BACKUP_AGE_IDENTITY=""
MEDIA_MAX_BYTES=134217728

# Max simultaneous media conversions across the whole bot
MAX_CONCURRENT_JOBS=4
# Hard timeout for a single ffmpeg/rlottie invocation (seconds)
JOB_TIMEOUT=120
# Per-user cooldown between media submissions (seconds)
THROTTLE_SECONDS=2

# ---- Premium emoji ----
# Requires the bot owner to hold Telegram Premium (or a Fragment username).
# The bot falls back to unicode emoji automatically if Telegram rejects them.
PREMIUM_EMOJI_ENABLED=true
